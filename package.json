{
  "name": "frontrunner",
  "version": "1.23.0",
  "description": "AI job search that filters deterministically first and spends the model only where judgement is needed. Fork of career-ops.",
  "imports": {
    "#paths": "./src/paths.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node test-all.mjs",
    "qa": "npm test && npm run benchmark:check",
    "qa:ui": "npm --prefix ui run typecheck && npm --prefix ui run build",
    "qa:full": "npm run qa && npm run qa:ui",
    "hooks:install": "git config core.hooksPath .github/hooks",
    "doctor": "node doctor.mjs",
    "start": "node src/application/start.mjs",
    "launcher": "node src/application/install-launcher.mjs",
    "ui": "npm --prefix ui run dev",
    "ui:install": "npm --prefix ui ci",
    "browser:install": "playwright install chromium",
    "or": "node src/evaluate/openrouter-runner.mjs",
    "or:scan": "node src/evaluate/openrouter-runner.mjs scan",
    "or:pipeline": "node src/pipeline/run.mjs --engine openrouter",
    "or:eval": "node src/evaluate/openrouter-runner.mjs evaluate",
    "or:apply": "node src/evaluate/openrouter-runner.mjs apply",
    "verify": "node src/tracker/verify-pipeline.mjs",
    "normalize": "node src/tracker/normalize-statuses.mjs",
    "dedup": "node src/tracker/dedup-tracker.mjs",
    "merge": "node src/tracker/merge-tracker.mjs",
    "reconcile": "node src/tracker/reconcile-pipeline.mjs",
    "pdf": "node src/cv/generate-pdf.mjs",
    "img-to-pdf": "node src/cv/img-to-pdf.mjs",
    "cover-letter": "node src/cv/generate-cover-letter.mjs --payload",
    "cv:verify-facts": "node src/cv/verify-cv-facts.mjs",
    "application:artifacts": "node src/cv/application-artifacts.mjs",
    "sync-check": "node src/cv/cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update:test": "node tests/updater-migration-tests.mjs",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "workspace:archive": "node src/workspace/archive-legacy.mjs",
    "liveness": "node src/scan/check-liveness.mjs",
    "extract": "node src/scan/browser-extract.mjs",
    "scan": "node src/scan/scan.mjs",
    "pipeline": "node src/pipeline/run.mjs",
    "pipeline:prepare": "node src/pipeline/run.mjs --prepare-only",
    "benchmark": "node src/benchmark/pipeline-benchmark.mjs --write",
    "benchmark:check": "node src/benchmark/pipeline-benchmark.mjs --check",
    "benchmark:prefilter": "node src/benchmark/prefilter-calibration.mjs",
    "scan:full": "node src/scan/scan-ats-full.mjs",
    "scan:seeds": "node src/scan/scan-ats-full.mjs --seeds yc,a16z",
    "scan:yc": "node src/scan/scan-ats-full.mjs --seeds yc",
    "validate:portals": "node src/scan/validate-portals.mjs",
    "verify:portals": "node src/scan/verify-portals.mjs",
    "fix:slugs": "node src/scan/fix-slugs.mjs",
    "freshness": "node src/analysis/check-table-freshness.mjs",
    "digest": "node src/analysis/weekly-interview-digest.mjs",
    "tracker": "node src/tracker/tracker.mjs",
    "find": "node find.mjs",
    "patterns": "node src/analysis/analyze-patterns.mjs",
    "upskill": "node src/analysis/upskill.mjs",
    "add": "node src/tracker/add-entry.mjs",
    "reposts": "node src/analysis/detect-reposts.mjs",
    "invite-match": "node src/tracker/invite-match.mjs",
    "paste-reply": "node src/tracker/paste-reply.mjs",
    "gemini:eval": "node src/evaluate/gemini-eval.mjs",
    "ollama:eval": "node src/evaluate/ollama-eval.mjs",
    "openai:eval": "node src/evaluate/openai-eval.mjs",
    "claude:eval": "node src/evaluate/claude-eval.mjs",
    "openai:tailor": "node src/evaluate/openai-tailor.mjs",
    "eval:golden": "node src/evaluate/eval-golden.mjs",
    "star": "node src/evaluate/match-star.mjs",
    "archive": "node src/scan/archive-posting.mjs",
    "prepare:application": "node src/evaluate/prepare-application.mjs",
    "check:paths": "node src/lib/root-paths.mjs",
    "fix:paths": "node src/lib/root-paths.mjs --fix"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "codex",
    "antigravity",
    "career",
    "automation",
    "ai-agent-skill"
  ],
  "author": "Furls Digital Ltd (https://furls.co.uk)",
  "homepage": "https://frontrunner.website",
  "repository": {
    "type": "git",
    "url": "https://github.com/Furls-Digital/frontrunner"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.0.0",
    "js-yaml": "^4.1.1",
    "playwright": "1.62.0",
    "re2js": "2.8.6",
    "yaml": "^2.9.0"
  },
  "bugs": {
    "url": "https://github.com/Furls-Digital/frontrunner/issues"
  }
}
