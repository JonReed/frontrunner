# One private boundary. It is deliberately blanket-ignored: no tracked
# placeholder may make a fresh install look initialized, and newly introduced
# runtime filenames cannot accidentally become commit candidates.
/workspace/
local/

# Legacy private locations stay ignored until `node src/workspace/archive-legacy.mjs
# --apply` moves an older installation into workspace/.legacy-backup/. New code
# never reads or writes these paths.
cv.md
article-digest.md
voice-dna.md
portals.yml
config/profile.yml
config/cv-facts.json
config/benchmarks.yml
config/prefilter.yml
data/
reports/
output/
jds/
interview-prep/
writing-samples/
cv-versions/

# Legacy batch runtime locations.
batch/logs/
batch/tracker-additions/
batch/batch-state.tsv
batch/batch-input.tsv
batch/batch-input.filtered.tsv
batch/prefilter-rejects.tsv
batch/liveness-results.tsv
batch/liveness-active.tsv
batch/.pipeline-run.lock/
batch/.pipeline-run.lock.recover/

# Personal documents — never commit scans or copies of these (PII).
*passport*
*diploma*
*简历*
*学位*
*成绩单*

# Legacy customization paths.
modes/_profile.md
modes/_custom.md
.update-dismissed
.update-lock
.manifesto-noted

# Secrets and local tool state.
.env
**/.env.local
**/.env*.local
**/*.tsbuildinfo
.claude/settings.local.json
.claude/memory/
.playwright-mcp/
.frontrunner-web/

# Generated files.
.resolved-prompt-*
node_modules
bun.lock
*.bak
src/**/workspace/documents/
.tmp-script-test-*/
plan/
ui/.next/
ui/next-env.d.ts
ui/.jobs/

# OS/media.
.DS_Store
*.mov
*.mp4

# Retired dashboard binaries.
career-dashboard
career-dashboard.exe

# Lockfiles are tracked deliberately.
package-lock.json
!package-lock.json
!ui/package-lock.json
!web/package-lock.json
